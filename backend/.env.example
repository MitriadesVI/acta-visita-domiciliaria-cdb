# Copia este archivo a .env y ajusta los valores.

# --- Postgres ---
POSTGRES_USER=acta
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=acta
DATABASE_URL=postgresql+psycopg2://acta:cambia-esta-clave@db:5432/acta

# --- Seguridad ---
# Genera una con: openssl rand -hex 32
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Admin inicial (se crea al primer arranque) ---
ADMIN_EMAIL=admin@tudominio.gov.co
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NOMBRE=Administrador

# --- CORS (origen del frontend en Netlify; separa con coma si son varios) ---
CORS_ORIGINS=https://tu-app.netlify.app,http://localhost:3000

# --- Almacenamiento (MinIO) ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://files.tudominio.gov.co
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=cambia-esta-clave
S3_BUCKET=actas
S3_REGION=us-east-1
